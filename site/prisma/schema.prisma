// Prisma Schema — forjaviral-site
// SQLite por default; PostgreSQL em produção via DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  price        Int
  currency     String   @default("BRL")
  interval     String
  abacatePlanId String?
  features     Json
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders         Order[]
  subscriptions Subscription[]

  @@index([slug])
  @@index([active])
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders         Order[]
  subscriptions  Subscription[]
  credentials    AccessCredentials[]

  @@index([email])
}

model Order {
  id                String   @id @default(cuid())
  customerId        String
  planId            String
  status            String
  abacateCheckoutId String?
  abacateOrderId    String?
  amount            Int
  currency          String   @default("BRL")
  metadata          Json?
  createdAt         DateTime @default(now())
  paidAt            DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
  plan     Plan     @relation(fields: [planId], references: [id])
  credentials AccessCredentials[]

  @@index([customerId])
  @@index([status])
  @@index([abacateCheckoutId])
  @@index([createdAt])
}

model Subscription {
  id                     String   @id @default(cuid())
  customerId             String
  planId                 String
  status                 String
  provider               String   @default("AbacatePay")
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  orderId                String?

  customer Customer @relation(fields: [customerId], references: [id])
  plan     Plan     @relation(fields: [planId], references: [id])
  credentials AccessCredentials[]

  @@index([customerId])
  @@index([status])
  @@index([providerSubscriptionId])
}

model AccessCredentials {
  id             String    @id @default(cuid())
  customerId     String
  orderId        String?
  subscriptionId String?
  username       String
  passwordHash   String?
  accessTokenHash String?
  accessUrl      String
  railwayAppUrl  String?
  licenseKey     String?
  credits        Int?      @default(100)
  courseUrl      String?
  status         String    @default("pending")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  order     Order?     @relation(fields: [orderId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([accessTokenHash])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String   @default("AbacatePay")
  eventId    String   @unique
  type       String
  payload    Json
  signature  String?
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  orderId    String?

  @@index([provider])
  @@index([eventId])
  @@index([processed])
  @@index([createdAt])
  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventType String
  userId    String?
  orderId   String?
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([orderId])
  @@index([createdAt])
}