# ──────────────────────────────────────────────────────────────
# fabricadecortes-site — Variáveis de Ambiente de Produção
# Copie este arquivo para .env no servidor Hostinger e preencha os valores.
# ──────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=https://fabricadecortes.com
NODE_ENV=production

# Banco de Dados (Prisma)
DATABASE_URL=file:./dev.db

# ── AbacatePay ──
ABACATEPAY_API_KEY=abc_live_...
ABACATEPAY_WEBHOOK_SECRET=seu_webhook_secret
ABACATEPAY_RETURN_URL=https://fabricadecortes.com/retorno
ABACATEPAY_APP_NAME=Fábrica de Cortes

# ── Servidor de Licenças / PostgreSQL Railway ──
FORJA_LICENSE_SERVER_URL=https://forja-license-production.up.railway.app
FORJA_LICENSE_ADMIN_TOKEN=FV291125

# ── Painel Admin ──
ADMIN_EMAIL=admin@fabricadecortes.com
ADMIN_PASSWORD=sua_senha_segura
ACCESS_TOKEN_SECRET=fabrica-de-cortes-secure-access-token-secret-2026

# ── E-mail (Resend) ──
RESEND_API_KEY=re_...
EMAIL_FROM=Fábrica de Cortes <contato@fabricadecortes.com>

# ── Tokens ──
# Chave secreta para assinar cookies de sessão e tokens one-time
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-me
ACCESS_LINK_EXPIRATION_HOURS=72

# ── Rate Limit ──
# Max requisições por janela (checkout, webhook, acesso)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000