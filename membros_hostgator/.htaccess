# ========================================================
# FÁBRICA DE CORTES - REGRAS APACHE / HOSTGATOR
# ========================================================

Options -Indexes
ServerSignature Off

# Forçar UTF-8
AddDefaultCharset UTF-8

# Bloquear acesso direto ao arquivo de schema SQL
<Files "schema.sql">
    Order Allow,Deny
    Deny from all
</Files>

# Habilitar RewriteEngine para URLs limpas
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# Compressão GZIP para carregar o Netflix Player ultra-rápido
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
