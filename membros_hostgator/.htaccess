# ========================================================
# FÁBRICA DE CORTES - REGRAS APACHE / HOSTGATOR
# ========================================================

Options -Indexes
ServerSignature Off

# Forçar UTF-8
AddDefaultCharset UTF-8

DirectoryIndex index.php index.html

# Bloquear acesso direto a bancos e schemas
<FilesMatch "\.(sqlite|db|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Habilitar RewriteEngine para URLs limpas
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# Compressão GZIP para carregar o Netflix Player ultra-rápido
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
